# NetBox base URL (http:// or https://), without /api
NETBOX_URL=http://netbox.example:8000
# API token only - no "Bearer"/"Token" prefix. v2 (nbt_...) and legacy v1 tokens both work.
NETBOX_TOKEN=

# HTTPS options
# NETBOX_VERIFY_SSL=true
# NETBOX_CA_BUNDLE=/path/to/internal-ca.pem
# NETBOX_TIMEOUT=30

# Register create/update/delete tools
# NETBOX_MCP_ENABLE_WRITES=false
# Schema index cache (empty disables)
# NETBOX_MCP_CACHE_DIR=~/.cache/netbox-mcp

# --- HTTP transport (Docker) ---------------------------------------------------------------
# Bearer tokens, one entry per person: name:sha256:<hash> (preferred) or name:<raw token>.
# Generate with: netbox-mcp token <name>   (or: docker compose run --rm netbox-mcp netbox-mcp token <name>)
# MCP_AUTH_TOKENS=alice:sha256:...,bob:sha256:...
# Or one entry per line in a file (e.g. a Docker secret):
# MCP_AUTH_TOKENS_FILE=/run/secrets/mcp_tokens
# Host port docker compose publishes (container listens on 8000)
# MCP_PUBLISH_PORT=8000
# MCP_PATH=/mcp

# LOG_LEVEL=INFO
